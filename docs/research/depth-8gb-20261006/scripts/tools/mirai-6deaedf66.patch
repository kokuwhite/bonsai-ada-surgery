+    } else {
+        if (swa) { is_2d ? set_input_kq_mask_packed_impl<false, true,  true >(args, data) : set_input_kq_mask_packed_impl<false, true,  false>(args, data); }
+        else     { is_2d ? set_input_kq_mask_packed_impl<false, false, true >(args, data) : set_input_kq_mask_packed_impl<false, false, false>(args, data); }
+    }
+}
